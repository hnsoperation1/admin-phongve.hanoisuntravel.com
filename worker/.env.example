NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Tuỳ chọn — mặc định 20000ms (gửi job) / 4000ms (kiểm tra yêu cầu đăng
# nhập lại). Không cần ZALO_SESSION_CREDENTIALS ở đây nữa — worker tự đọc
# session mới nhất từ bảng zalo_session (Supabase), cập nhật qua trang
# "Đăng nhập lại Zalo" trên web (xem README.md).
POLL_INTERVAL_MS=20000
LOGIN_CHECK_INTERVAL_MS=4000
