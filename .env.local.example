NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# JSON của Credentials zca-js (imei, cookie, userAgent) lấy từ 1 lần đăng
# nhập QR thủ công (xem scripts/zalo-login.ts) — dùng để login lại session
# mỗi lần cron chạy (serverless, không giữ state giữa các lần gọi).
ZALO_SESSION_CREDENTIALS=

# Header bí mật để Vercel Cron xác thực khi gọi route xử lý job đến hạn,
# tránh route bị gọi trực tiếp từ bên ngoài.
CRON_SECRET=
